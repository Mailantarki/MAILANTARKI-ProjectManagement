# URL del proyecto Supabase local o Cloud
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública para el cliente del navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privilegiada; solo servidor y scripts de confianza
SUPABASE_SERVICE_ROLE_KEY=

# Secreto aleatorio para hashes de códigos de acceso
ACCESS_CODE_PEPPER=

# Secreto aleatorio para firmar sesiones de visitantes
VISITOR_SESSION_SECRET=

# Opcional: emails de publicación (Resend). Sin RESEND_API_KEY no se envía nada.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Mailantarki Portal <portal@mailantarki.com>"
EMAIL_FROM=
# URL pública del portal para los links de los emails, p. ej. https://portal.mailantarki.com
PORTAL_URL=
