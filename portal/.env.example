# URL del proyecto Supabase local o Cloud
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública para el cliente del navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privilegiada; solo servidor y scripts de confianza
SUPABASE_SERVICE_ROLE_KEY=

# Secreto aleatorio para hashes de códigos de acceso
ACCESS_CODE_PEPPER=

# Secreto aleatorio para firmar sesiones de visitantes
VISITOR_SESSION_SECRET=
